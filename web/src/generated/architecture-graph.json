  "flows": [
    {
      "id": "product-chat-flow",
      "label": "AI 对话产品链路",
      "description": "用户登录后进入对话工作台，通过会话管理组织和找回历史内容，在一次提问中可结合消息操作、附件、长期记忆、个性化偏好和 AI 工具能力完成任务。",
      "steps": [
        "product-entry",
        "product-chat",
        "product-conversation-management",
        "product-message-operations",
        "product-files",
        "product-memory",
        "product-preferences",
        "product-ai-capabilities"
      ]
    },
    {
      "id": "product-knowledge-flow",
      "label": "知识库产品链路",
      "description": "知识库先在独立页面完成上传、编辑、重建索引和团队协作，再作为可访问资料被对话引用；它不是对话的附属功能，而是一条可独立维护的知识资产链路。",
      "steps": [
        "product-entry",
        "product-knowledge-management",
        "product-knowledge-collaboration",
        "product-knowledge-reference",
        "product-chat"
      ]
    },
    {
      "id": "product-model-admin-flow",
      "label": "后台模型治理链路",
      "description": "管理员进入模型后台维护对话和专用模型；对话模型的默认项与排序直接发布到用户设置，必要时可将全部用户统一切换到指定模型，运行时能力同步读取最新专用配置。",
      "steps": [
        "product-entry",
        "product-model-admin",
        "product-preferences",
        "product-chat",
        "product-ai-capabilities"
      ]
    },
    {
      "id": "model-management-technical-flow",
      "label": "模型配置运行时链路",
      "description": "模型管理后台通过管理员 API 写入 AiModel 表并使注册表缓存失效；聊天、RAG、图片理解、语音和文生图调用时由运行时注册表解析当前配置，再访问外部模型服务。",
      "steps": [
        "frontend-model-admin",
        "frontend-network",
        "backend-model-management",
        "data-ai-model-config",
        "ai-model-registry",
        "ai-orchestrator",
        "external-ai"
      ]
    },
    {
      "id": "guest-auth-technical-flow",
      "label": "可恢复访客认证链路",
      "description": "前端读取浏览器保存的访客恢复密钥并调用访客认证接口；后端按密钥哈希恢复已有访客，或通过数据库 sequence 创建递增访客账号，再复用统一 JWT 会话返回工作台。",
      "steps": [
        "frontend-app",
        "frontend-network",
        "backend-api",
        "backend-guest-auth",
        "external-database"
      ]
    },
    {
      "id": "chat-technical-flow",
      "label": "AI 对话技术链路",
      "description": "前端工作台通过 API/SSE 连接后端消息服务，后端组装上下文、调用工具和模型，再把流式结果返回前端。",
      "steps": [
        "frontend-app",
        "frontend-network",
        "backend-api",
        "ai-orchestrator",
        "tool-runtime",
        "external-ai"
      ]
    },
    {
      "id": "tool-external-flow",
      "label": "工具与外部服务链路",
      "description": "模型触发工具后，后端工具运行时按工具类型连接 DashScope WebSearch MCP、DashScope 图片生成、浏览器定位和高德逆地理编码；生成图片会转存到 R2 后再返回前端。",
      "steps": [
        "ai-orchestrator",
        "tool-runtime",
        "external-dashscope-websearch",
        "external-dashscope-image",
        "external-storage",
        "browser-client-tools",
        "external-amap"
      ]
    },
    {
      "id": "knowledge-technical-flow",
      "label": "知识库 RAG 技术链路",
      "description": "知识库服务管理权限和内容更新，RAG 系统负责切分、Embedding、向量存储和检索，回答时把相关片段注入模型上下文。",
      "steps": [
        "frontend-app",
        "backend-knowledge",
        "rag-system",
        "external-ai",
        "external-database",
        "ai-orchestrator"
      ]
    },
    {
      "id": "storage-deploy-flow",
      "label": "外部系统与部署链路",
      "description": "后端通过 Prisma 访问 PostgreSQL/pgvector，通过 R2 保存对象文件；生产环境由 Docker、Railway 和 Nginx 代理组成。",
      "steps": [
        "deployment",
        "frontend-network",
        "backend-api",
        "external-database",
        "external-storage",
        "external-ai"
      ]
    }
  ]
}
