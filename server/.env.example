# 运行环境。开发环境可填 development，生产部署填 production。
NODE_ENV=development

# 后端服务监听端口。本地常用 5172；Railway 通常会自动注入 PORT。
PORT=5172

# JWT 签名密钥。生产环境必须使用足够长的随机字符串，不能提交到公开仓库。
JWT_SECRET=

# 访问 Token 有效期（秒）。默认 3600，即 1 小时。
JWT_ACCESS_TOKEN_TTL_SECONDS=

# 刷新 Token 有效期（秒）。默认 86400，即 24 小时。
JWT_REFRESH_TOKEN_TTL_SECONDS=

# PostgreSQL/Neon 数据库连接串。生产环境必填，包含账号密码，不能公开。
# Neon 建议保留 sslmode=require，并添加 connect_timeout=15，避免休眠端点冷启动超过 Prisma 默认 5 秒超时。
DATABASE_URL=

# 允许跨域访问后端的前端 Origin 列表，多个用英文逗号分隔；生产环境必须包含前端域名。
CORS_ORIGINS=

# DashScope 兼容 OpenAI 的模型调用地址；不填时后端代码有默认值。
DASHSCOPE_BASE_URL=

# DashScope API Key，用于默认大模型、视觉分析、联网搜索等能力。
DASHSCOPE_API_KEY=

# DashScope 图片生成 API Key。不填时会复用 DASHSCOPE_API_KEY。
DASHSCOPE_IMAGE_API_KEY=

# DashScope 图片生成完整接口地址。
DASHSCOPE_IMAGE_GENERATION_URL=

# DashScope WebSearch MCP 地址。
DASHSCOPE_WEBSEARCH_MCP_URL=

# 是否启用内置联网搜索，true 或 false。
DASHSCOPE_WEBSEARCH_ENABLED=

# 高德地图 Web 服务 Key，用于 getUserLocationTool 的逆地理编码。
AMAP_API_KEY=

# 高德逆地理编码完整接口地址。
AMAP_REGEOCODE_URL=

# Cloudflare R2/S3 兼容对象存储桶名称。
STORAGE_BUCKET=

# Cloudflare R2/S3 兼容对象存储 Access Key ID，不能公开。
STORAGE_ACCESS_KEY_ID=

# Cloudflare R2/S3 兼容对象存储 Secret Access Key，不能公开。
STORAGE_SECRET_ACCESS_KEY=

# Cloudflare R2/S3 endpoint。可选；不填时后端会尝试从 STORAGE_DOMAIN 推导。
STORAGE_ENDPOINT=

# Cloudflare R2/S3 访问域名，用于生成文件预览/下载地址。
STORAGE_DOMAIN=

# OpenAI API Key。可选；没有 DASHSCOPE_API_KEY 时可作为备用模型提供方。
OPENAI_API_KEY=

# OpenAI 兼容 API 地址。可选。
OPENAI_BASE_URL=
